package main

import (
	"fmt"
	"math"
)

func WilsonBad(n, bad int) (lo, hi float64) {
	if n == 0 {
		return 0, 1
	}
	const z = 1.96
	p := float64(bad) / float64(n)
	den := 1 + z*z/n
	mid := (p + z*z/(2*n)) / den
	half := z*math.Sqrt(p*(1-p)/n + z*z/(4*n*n))
	return math.Max(0, mid-half), math.Min(1, mid+half)
}

func WilsonGood(n, bad int) (lo, hi float64) {
	if n == 0 {
		return 0, 1
	}
	const z = 1.96
	p := float64(bad) / float64(n)
	den := 1 + z*z/n
	mid := (p + z*z/(2*n)) / den
	half := z*math.Sqrt(p*(1-p)/n + z*z/(4*n*n)) / den   // ← divide by den here!
	return math.Max(0, mid-half), math.Min(1, mid+half)
}

func WilsonCorrect(n, bad int) (lo, hi float64) {
	if n == 0 {
		return 0, 1
	}
	const z = 1.96
	p := float64(bad) / float64(n)
	den := 1 + z*z/n
	midNum := p + z*z/(2*n)
	halfNum := z * math.Sqrt(p*(1-p)/n + z*z/(4*n*n))
	return (midNum - halfNum) / den, (midNum + halfNum) / den
}

func main() {
	n, bad := 10, 5
	fmt.Printf("N=%d, Bad=%d (%.2f%%)\n", n, bad, 100*float64(bad)/float64(n))
	
	lo, hi := WilsonBad(n, bad)
	fmt.Printf("Broken:   [%1.3f, %1.3f] (width=%1.3f)\n", lo, hi, hi-lo)
	
	lo2, hi2 := WilsonGood(n, bad)
	fmt.Printf("Fixed:    [%1.3f, %1.3f] (width=%1.3f)\n", lo2, hi2, hi2-lo2)
	
	lo3, hi3 := WilsonCorrect(n, bad)
	fmt.Printf("Reference: [%1.3f, %1.3f] (width=%1.3f)\n", lo3, hi3, hi3-lo3)
	
	// Test a few more cases
	for _, test := range []struct{ n, b int }{{10, 5}, {20, 2}, {50, 7}, {100, 12}} {
		lb, hb := WilsonGood(test.n, test.b)
		fmt.Printf("  n=%3d b=%2d: %sWilson(%1.3f%%)] -> [%1.4f, %1.4f]\n", 
			test.n, test.b, "   ", float64(test.b)/float64(test.n)*100, lb, hb)
	}
}
EOF
