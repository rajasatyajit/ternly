func TestLRUPeekWithExpiry(t *testing.T) {
	lc := NewLRU[string, string](10, nil, time.Minute)

	start := time.Now()
	lc.Add("key1", "val1")

	v, expiresAt, ok := lc.PeekWithExpiry("key1")
	if !ok {
		t.Fatalf("should be true")
	}
	if v != "val1" {
		t.Fatalf("value differs from expected")
	}
	if expiresAt.Before(start.Add(time.Minute)) || expiresAt.After(time.Now().Add(time.Minute)) {
		t.Fatalf("expiry differs from expected")
	}

	// Missing key
	v, expiresAt, ok = lc.PeekWithExpiry("key2")
	if ok {
		t.Fatalf("should be false")
	}
	if v != "" || !expiresAt.IsZero() {
		t.Fatalf("zero values expected")
	}

	// Expired entry
	lc2 := NewLRU[string, string](10, nil, time.Nanosecond)
	lc2.Add("key1", "val1")
	time.Sleep(time.Millisecond)
	v, expiresAt, ok = lc2.PeekWithExpiry("key1")
	if ok {
		t.Fatalf("should be false for expired entry")
	}
	if v != "" || !expiresAt.IsZero() {
		t.Fatalf("zero values expected for expired entry")
	}
}
EOF
