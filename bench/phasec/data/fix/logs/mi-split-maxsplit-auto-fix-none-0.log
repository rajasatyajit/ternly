func split_at(s string, maxsplit int) (string, string) {
  parts := strings.SplitN(s, "/", maxsplit)
  if len(parts) > maxsplit {
    parts = parts[:maxsplit]
  }
  return strings.Join(parts[:len(parts)-1], "/"), strings.Join(parts[len(parts)-1:], "/")
}
```

