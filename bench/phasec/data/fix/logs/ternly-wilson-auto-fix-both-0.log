package main

import (
	"fmt"
	"math"
)

type Counts struct {
	Bad int
	N   int
}

func (c Counts) Rate() float64 {
	if c.N == 0 {
		return 0
	}
	return float64(c.Bad) / float64(c.N)
}

// BUGGY version (current code)
func (c Counts) WilsonBuggy() (lo, hi float64) {
	if c.N == 0 {
		return 0, 1
	}
	const z = 1.96
	n, p := float64(c.N), c.Rate()
	den := 1 + z*z/n
	mid := (p + z*z/(2*n)) / den
	half := z * math.Sqrt(p*(1-p)/n + z*z/(4*n*n))
	return math.Max(0, mid-half), math.Min(1, mid+half)
}

// FIXED version
func (c Counts) WilsonFixed() (lo, hi float64) {
	if c.N == 0 {
		return 0, 1
	}
	const z = 1.96
	n := float64(c.N)
	p := float64(c.Bad) / n
	den := 1 + z*z/n
	mid := (p + z*z/(2*n)) / den
	half := z * math.Sqrt(p*(1-p)/n + z*z/(4*n*n)) / math.Sqrt(n)
	return math.Max(0, mid-half), math.Min(1, mid+half)
}

func main() {
	c := Counts{Bad: 5, N: 10}
	loB, hiB := c.WilsonBuggy()
	loF, hiF := c.WilsonFixed()
	fmt.Printf("Input: Bad=5, N=10\n")
	fmt.Printf("Rate: %.6f\n", c.Rate())
	fmt.Printf("BUGGY: lo=%.6f  hi=%.6f  width=%.4f\n", loB, hiB, hiB-loB)
	fmt.Printf("FIXED: lo=%.6f  hi=%.6f  width=%.4f\n", loF, hiF, hiF-loF)
	
	// Manual check for fixed version:
	n := float64(10)
	p := 0.5
	z := 1.96
	den := 1 + z*z/n
	mid := (p + z*z/(2*n)) / den
	half := z * math.Sqrt(p*(1-p)/n + z*z/(4*n*n)) / math.Sqrt(n)
	fmt.Printf("\nManual fixed: mid=%.6f half=%.6f -> [%.4f, %.4f]\n", mid, half, mid-half, mid+half)
	
	// Expected correct Wilson (0.2392, 0.7608 per standard calc)
	fmt.Printf("\nExpected Wilson: [0.2392, 0.7608]\n")
}
EOF
