#!/usr/bin/env bash
# ternly's fast tier before every push (~20 s; `make hooks` installs it).
# The full tier (race, sandbox, e2e) runs in CI. Skip once: git push --no-verify.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
unformatted=$(gofmt -l . | grep -v '^dist/' || true)
if [ -n "$unformatted" ]; then
  echo "pre-push: gofmt needed:" >&2; echo "$unformatted" >&2; exit 1
fi
go vet ./...
go test -short -count=1 ./...
# the confinement lint (ADR 013), named so it can't be skipped by -short
go test -count=1 -run '^TestOnlyConfinedReads$' ./internal/rootfs
echo "pre-push: fast tier passed"
